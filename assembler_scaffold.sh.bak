#! /bin/bash

die() { echo "assembler: $*"; exit 1; }   # TODO: doc says STDOUT, confirm on Ed (else add >&2 here)


# ---- 1. Check arguments -----------------------
[ ! $# -eq 1 ] && die "Usage: $0 <file.vsc>"
[[ ! "$1" =~ \.vsc$ ]] && die "Error: File must have .vsc extension: $1"
[ ! -f "$1" ] && die "Error: File not found: $1"


# ---- 2. Read all non-empty lines --------------
n_values=""       # number of static data (from line 1)
values=()         # static data
instructions=()   # un-parsed instruction lines

while IFS= read -r line || [ -n "$line" ]; do
  [ -z "$line" ] && continue

  if [ -z "$n_values" ]; then
    n_values="$line"
  elif (( ${#values[@]} < n_values )); then
    values+=("$line")
  else
    instructions+=("$line")
  fi
done < "$1"


